{
    "account_id": "460a5030a0cb7f2951f6daf7eef161c4",
    "compatibility_date": "2025-05-05",
    "compatibility_flags": ["nodejs_compat"],
    "main": "worker/index.ts",
    "name": "sandmill-mac",
    "workers_dev": true,
    "kv_namespaces": [
        {
            "binding": "VARZ",
            "id": "812b3a7c31c44d539abcfcd97dff234d",
            "preview_id": "ea9f9c8257e643118313c2bf85a3cdf5",
        },
    ],
    "migrations": [
        {
            "new_sqlite_classes": ["EthernetZone"],
            "tag": "v1",
        },
    ],
    "assets": {
        "binding": "ASSETS",
        "directory": "./build",
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
    },
    "r2_buckets": [
        {
            "binding": "DISK_BUCKET",
            "bucket_name": "sandmill-mac-disk",
            "preview_bucket_name": "sandmill-mac-disk",
        },
    ],
    "durable_objects": {
        "bindings": [
            {
                "class_name": "EthernetZone",
                "name": "ETHERNET_ZONE",
            },
        ],
    },
    "env": {
        "production": {
            "kv_namespaces": [
                {
                    "binding": "VARZ",
                    "id": "812b3a7c31c44d539abcfcd97dff234d",
                },
            ],
            "r2_buckets": [
                {
                    "binding": "DISK_BUCKET",
                    "bucket_name": "sandmill-mac-disk",
                },
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "class_name": "EthernetZone",
                        "name": "ETHERNET_ZONE",
                    },
                ],
            },
        },
    },
    "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1,
    },
}
